# Environment Variables — Live Testing Sistem Trading BEI
# =========================================================
# Copy ini menjadi .env.local untuk environment lokal
# =========================================================

# =========================================================
# 1. UNTUK VERCEL (Frontend Next.js Environment Variables)
# =========================================================
# Wajib di-setting di Vercel Dashboard -> Settings -> Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# (Opsional jika ingin trigger GitHub Actions via endpoint /api/cron dari cron-job.org)
CRON_SECRET=your_custom_secret_key_here
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repo_name

# =========================================================
# 2. UNTUK GITHUB ACTIONS (Settings -> Secrets and variables -> Actions)
# =========================================================
# Wajib di-setting di GitHub Repository Secrets:
# 1. STOCKBIT_USERNAME
# 2. STOCKBIT_PASSWORD
# 3. STOCKBIT_PLAYER_ID
# 4. SUPABASE_URL (https://your-project.supabase.co)
# 5. SUPABASE_KEY (Gunakan SERVICE_ROLE_KEY Supabase untuk izin write DB)
STOCKBIT_USERNAME=your_stockbit_username
STOCKBIT_PASSWORD=your_stockbit_password
STOCKBIT_PLAYER_ID=your_stockbit_player_id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_secret_key